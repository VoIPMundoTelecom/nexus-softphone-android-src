            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="16dp"
            android:text="@string/ondafone_recurso_gravacao"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="@{viewModel.ondafoneLimitado ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintTop_toBottomOf="@id/recurso_video"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/recurso_gravacao_selo"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_600"
            android:onClick="@{() -> viewModel.ondafoneOferta(`gravacao`)}"
            android:id="@+id/recurso_gravacao_selo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/shape_ondafone_selo"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:text="@string/ondafone_selo"
            android:textColor="@color/bc_white"
            android:textSize="13sp"
            android:visibility="@{viewModel.ondafoneLimitado ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintTop_toTopOf="@id/recurso_gravacao"
            app:layout_constraintBottom_toBottomOf="@id/recurso_gravacao"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/settings_title_style"
            android:onClick="@{() -> viewModel.ondafoneOferta(`conferencia`)}"
            android:id="@+id/recurso_conferencia"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="16dp"
            android:text="@string/ondafone_recurso_conferencia"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="@{viewModel.ondafoneLimitado ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintTop_toBottomOf="@id/recurso_gravacao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/recurso_conferencia_selo"/>

        <androidx.appcompat.widget.AppCompatTextView
