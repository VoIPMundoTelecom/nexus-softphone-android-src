<?xml version="1.0" encoding="utf-8"?>
<!-- Ondafone (S3, 03/11): modo limitado/completo, "Usar minha operadora", recursos bloqueados com selo e oferta -->
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable
            name="viewModel"
            type="org.linphone.ui.main.settings.viewmodel.SettingsViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp"
        android:background="@drawable/shape_squircle_white_background">

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/settings_title_style"
            android:id="@+id/modo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            android:text="@{viewModel.ondafoneLimitado ? @string/ondafone_modo_limitado : @string/ondafone_modo_completo, default=@string/ondafone_modo_limitado}"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/settings_subtitle_style"
            android:id="@+id/modo_explicacao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:maxLines="4"
            android:text="@{viewModel.ondafoneLimitado ? @string/ondafone_modo_limitado_explicacao : @string/ondafone_modo_completo_explicacao, default=@string/ondafone_modo_limitado_explicacao}"
            app:layout_constraintTop_toBottomOf="@id/modo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/settings_title_style"
            android:onClick="@{() -> viewModel.ondafoneUsarMinhaOperadora()}"
            android:id="@+id/usar_minha_operadora"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            android:text="@string/ondafone_usar_minha_operadora"
            android:drawableEnd="@drawable/caret_right"
            android:drawableTint="?attr/color_main2_600"
            app:layout_constraintTop_toBottomOf="@id/modo_explicacao"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/settings_subtitle_style"
            android:onClick="@{() -> viewModel.ondafoneUsarMinhaOperadora()}"
            android:id="@+id/usar_minha_operadora_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@string/ondafone_usar_minha_operadora_sub"
            app:layout_constraintTop_toBottomOf="@id/usar_minha_operadora"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/settings_title_style"
            android:onClick="@{() -> viewModel.ondafoneOferta(`video`)}"
            android:id="@+id/recurso_video"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="16dp"
            android:text="@string/ondafone_recurso_video"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="@{viewModel.ondafoneLimitado ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintTop_toBottomOf="@id/usar_minha_operadora_sub"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/recurso_video_selo"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/default_text_style_600"
            android:onClick="@{() -> viewModel.ondafoneOferta(`video`)}"
            android:id="@+id/recurso_video_selo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/shape_ondafone_selo"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:maxLines="1"
            android:text="@string/ondafone_selo"
            android:textColor="@color/bc_white"
            android:textSize="13sp"
            android:visibility="@{viewModel.ondafoneLimitado ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintTop_toTopOf="@id/recurso_video"
            app:layout_constraintBottom_toBottomOf="@id/recurso_video"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/settings_title_style"
            android:onClick="@{() -> viewModel.ondafoneOferta(`gravacao`)}"
