            app:layout_constraintTop_toTopOf="@id/recurso_provisionamento"
            app:layout_constraintBottom_toBottomOf="@id/recurso_provisionamento"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
            style="@style/settings_title_style"
            android:onClick="@{() -> viewModel.ondafoneOferta(`contas_adicionais`)}"
            android:id="@+id/recurso_contas_adicionais"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="16dp"
            android:text="@string/ondafone_recurso_contas_adicionais"
            android:maxLines="2"
