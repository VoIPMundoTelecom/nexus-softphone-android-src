            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="@{viewModel.ondafoneLimitado ? View.VISIBLE : View.GONE, default=gone}"
            app:layout_constraintTop_toBottomOf="@id/recurso_conferencia"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/recurso_transferencia_assistida_selo"/>

        <androidx.appcompat.widget.AppCompatTextView
