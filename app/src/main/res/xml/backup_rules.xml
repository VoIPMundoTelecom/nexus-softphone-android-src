<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!--
   <include domain="sharedpref" path="."/>
   <exclude domain="sharedpref" path="device.xml"/>
    -->
    <exclude domain="sharedpref" path="encrypted.pref"/>
    <!-- Ondafone: estado do modo completo é deste aparelho, nunca restaurado de backup -->
    <exclude domain="sharedpref" path="ondafone_modo.xml"/>
    <!-- Sessão do app no givm: a chave fica no Keystore deste aparelho; outro aparelho entra de novo. -->
    <exclude domain="sharedpref" path="ondafone_sessao.xml"/>
    <exclude domain="sharedpref" path="ondafone_aparelho.xml"/>
</full-backup-content>