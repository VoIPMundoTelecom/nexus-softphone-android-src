<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Ondafone: estado do modo completo é deste aparelho, nunca restaurado de backup -->
        <exclude domain="sharedpref" path="ondafone_modo.xml"/>
        <!-- Sessão do app no givm: a chave fica no Keystore deste aparelho; outro aparelho entra de novo. -->
        <exclude domain="sharedpref" path="ondafone_sessao.xml"/>
        <exclude domain="sharedpref" path="ondafone_aparelho.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ondafone_modo.xml"/>
        <exclude domain="sharedpref" path="ondafone_sessao.xml"/>
        <exclude domain="sharedpref" path="ondafone_aparelho.xml"/>
    </device-transfer>
</data-extraction-rules>
